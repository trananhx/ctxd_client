<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CtxdServer</AssemblyName>
    <RootNamespace>Ctxd.Server</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Server/*.cs are auto-included by the SDK. Add the shared, UnityEngine-free simulation source. -->
    <Compile Include="..\Assets\Ctxd\Battle\Sim\**\*.cs" />
  </ItemGroup>
</Project>
